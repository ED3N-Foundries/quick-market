# Production env for the standalone compose in this repo.
# Submission copy for the hackathon: core-infra's deploy/quick-market.env.example
# stays the ops canonical file. Values below match it plus the local
# .env.example files in quick-market and quick-market-agent.
#
# Setup (from this directory):
#   cp deploy.env.example deploy.env   # deploy.env is git-ignored, never commit it
# Fill the blank keys, then: docker compose up -d --build
#
# Layout: clone quick-market, quick-market-agent, quick-market-health as
# siblings, with this file's docker-compose.yml at quick-market/docker-compose.yml.
# The same deploy.env serves market + agent (compose overrides the agent's
# API_URL and DB_PATH to the container network / volume, see docker-compose.yml).

NODE_ENV=production
PORT=3001
HOST=0.0.0.0
DB_PATH=/data/quick-market.sqlite
CHAIN=base-sepolia

# Secrets. Fill before deploy. Treasury/agent keys never go in git.
TREASURY_PRIVATE_KEY=
NEAR_TREASURY_PRIVATE_KEY=
RPC_URL=
USDC_ADDRESS=
TOKEN_ACCOUNT=
TOKEN_PRIVATE_KEY=

# Origin this market process advertises. Override with the public URL in prod.
API_URL=http://127.0.0.1:3001

# Market preferences. Must match in market + agent (shared file, so they do).
WINDOW_SECONDS=10
MARKET_SECONDS=10
VIEW_SECONDS=5
FEE_BPS=0
PRICE_SOURCE=binance
CONFIRMATIONS=1
GRANT_MICROS=100000000
GRANT_INTERVAL_MS=120000

# Agent split: whole numbers that sum to 100. 0 leaves that market idle.
AGENT_SPLIT_BASE=50
AGENT_SPLIT_NEAR=50
# Agent-only (ignored by the market): stats listener + fixed crowd size.
# Compose maps the agent to its own volume; SWARM_PIN blank follows the clock.
STATS_PORT=3011
SWARM_PIN=

# NEAR testnet. url timeout_ms send_timeout_ms backoff_ms. Up to 4.
# Same defaults as the compose environment and .env.example: FastNear, ZAN, Intear, then dRPC.
NEAR_RPC_1=https://test.rpc.fastnear.com 4000 20000 1500
NEAR_RPC_2=https://api.zan.top/near-testnet 4000 8000 1500
NEAR_RPC_3=https://testnet-rpc.intea.rs 4000 8000 2000
NEAR_RPC_4=https://near-testnet.drpc.org 1800 1800 1000
