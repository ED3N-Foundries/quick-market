# Secrets. The schema reads these and does not hardcode them.
TREASURY_PRIVATE_KEY=
AGENT_SECRET=
RPC_URL=
USDC_ADDRESS=
TOKEN_ACCOUNT=
TOKEN_PRIVATE_KEY=

# Active network. The launcher loads .env.<CHAIN> and preserves its values.
CHAIN=near-testnet
ENV_FILES_VERSION=1

# Shared process settings. Network files also receive these defaults.
PORT=3001
DB_PATH=data/quick-market.sqlite
API_URL=http://127.0.0.1:3001
SWARM_PIN=

# Market preferences.
WINDOW_SECONDS=10
MARKET_SECONDS=10
VIEW_SECONDS=5
FEE_BPS=0
PRICE_SOURCE=binance
GRANT_MICROS=100000000
GRANT_INTERVAL_MS=120000
