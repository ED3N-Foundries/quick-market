# Secrets. The schema reads these and does not hardcode them.
TREASURY_PRIVATE_KEY=
NEAR_TREASURY_PRIVATE_KEY=
# Written by bun run treasury. Blank derives an existing implicit account from the key.
NEAR_TREASURY_ACCOUNT=
RPC_URL=

# NEAR testnet walks these in order. Each line is: url timeout_ms send_timeout_ms backoff_ms
# A read stops at timeout_ms. send_tx stops at send_timeout_ms. A busy endpoint waits out backoff_ms.
# A send that waits to be included starts on an endpoint with at least 8000 ms and the hops share that longest budget.
# Reads prefer FastNear/ZAN/Intear; dRPC is demoted to last (deprecation, ~15% failures) but its 1800 ms send ceiling
# still makes it the first hop for a fast broadcast accept. The official rpc.testnet.near.org node is about 30 calls a minute, so it is not listed.
NEAR_RPC_1=https://test.rpc.fastnear.com 4000 20000 1500
NEAR_RPC_2=https://api.zan.top/near-testnet 4000 8000 1500
NEAR_RPC_3=https://testnet-rpc.intea.rs 4000 8000 2000
NEAR_RPC_4=https://near-testnet.drpc.org 1800 1800 1000
USDC_ADDRESS=
TOKEN_ACCOUNT=
TOKEN_PRIVATE_KEY=

# Active network. Required by the server and agent. A market is on when its keys are filled.
# Base Sepolia: TREASURY_PRIVATE_KEY (hex) and USDC_ADDRESS.
# NEAR testnet: NEAR_TREASURY_PRIVATE_KEY (ed25519) and TOKEN_ACCOUNT.
CHAIN=base-sepolia

# Shared process settings. Bun loads this single .env file.
PORT=3001
DB_PATH=data/quick-market.sqlite
API_URL=http://127.0.0.1:3001

# Market preferences.
WINDOW_SECONDS=10
MARKET_SECONDS=10
VIEW_SECONDS=5
FEE_BPS=0
PRICE_SOURCE=binance
CONFIRMATIONS=1
GRANT_MICROS=100000000
GRANT_INTERVAL_MS=120000
