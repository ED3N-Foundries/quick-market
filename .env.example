# Secrets. The schema reads these and does not hardcode them.
TREASURY_PRIVATE_KEY=
AGENT_SECRET=
RPC_URL=
USDC_ADDRESS=

# This process. An empty RPC_URL uses the public RPC for the chain.
PORT=3001
DB_PATH=data/quick-market.sqlite
API_URL=http://127.0.0.1:3001
SWARM_PIN=

# Preferences. shared/market.ts checks these, then overrides them.
CHAIN=base-sepolia
WINDOW_SECONDS=5
MARKET_SECONDS=5
VIEW_SECONDS=5
FEE_BPS=0
PRICE_SOURCE=binance
GRANT_MICROS=100000000
GRANT_INTERVAL_MS=120000
