# Secrets. The schema reads these and does not hardcode them.
TREASURY_PRIVATE_KEY=
NEAR_TREASURY_PRIVATE_KEY=
RPC_URL=
USDC_ADDRESS=
TOKEN_ACCOUNT=
TOKEN_PRIVATE_KEY=

# Active network. Required by the server and agent. A market is on when its keys are filled.
# Base Sepolia: TREASURY_PRIVATE_KEY (hex) and USDC_ADDRESS.
# NEAR testnet: NEAR_TREASURY_PRIVATE_KEY (ed25519) and TOKEN_ACCOUNT.
CHAIN=base-sepolia

# Shared process settings. Bun loads this single .env file.
PORT=3001
DB_PATH=data/quick-market.sqlite
API_URL=http://127.0.0.1:3001

# Market preferences.
WINDOW_SECONDS=10
MARKET_SECONDS=10
VIEW_SECONDS=5
FEE_BPS=0
PRICE_SOURCE=binance
GRANT_MICROS=100000000
GRANT_INTERVAL_MS=120000
